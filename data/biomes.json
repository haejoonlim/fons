{
 "meta": {
  "v80": "biomes v1.3 — 사용자 확정 26바이옴 지도 · 2026-09-27",
  "structure": "하층 13세계(1~65층) → 중층 8세계(66~105층) → 상층 5세계(106~130층). 세계당 5층, 총 26세계.",
  "slotRule": "26개 세계의 슬롯 순서는 고정 지도다. slots[0]은 블록 번호 1~26, slots[1]은 5층 폭.",
  "spawnOverride": "B안 확정 — 일반 몬스터 편성은 biome.habitat 기반. monsters.json spawn.floors는 기록용 참조로 강등 (P2-1 편성표 폐기).",
  "gatekeeper": "세계 전용 문지기 — name(정식 명칭) + epithet(별칭·퇴치 카드 표기). GK층 편성 시 biome.gatekeeper 참조. (26블록 §10 · #59)",
  "categoryRule": "단일 소속 — synergy.json 우선순위(어둠>극한>혼돈>물가>평온) 적용해 정리 (2026-09-19). 지옥: dark+extreme 이중 → dark 단일 (심연층 불화 강화 우선). 사막: 누락 → extreme. 델타 조회는 biome.category 단일 키.",
  "regions": "regions[5] = 세계의 깊이 단계(가장자리→심층) — 블록 첫층 진입 풀카드용 지역명 · D(f)=13^((f-1)/129) 위험도 지수와 세트 (#58). 26개 세계는 각 5개 지역명과 전용 문지기를 포함한다.",
  "idCanonicalSource": "design-docs/에셋/biome_asset_manifest.json 의 biomes[].id 가 명명 정본. 2026-09-27 이전 biomes.json 은 12곳이 다른 이름을 쓰고 있었다.",
  "tiering": "사용자 확정 26바이옴 지도 — 하층 1~13번(1~65층), 중층 14~21번(66~105층), 상층 22~26번(106~130층). 세계당 5층, 순서는 슬롯 번호 고정. 거주·정착 표는 1~21번만 포함한다.",
  "tierGatekeepers": "계층문지기 2곳 — 65/66 경계 · 105/106 경계. 130층 이데아 관문은 계층문지기가 아니라 문(관문 그 자체)이므로 제외. 계층문지기는 그 계층 전체 규모의 상대이며 개별 세계 문지기 26명과는 난이도 축이 다르다.",
  "namingConvention": "바이옴 표시명은 2026-09-27 사용자 확정 지도. 내부 biome id는 게임·생태 참조 호환을 위해 보존한다.",
  "settlementScope": "정착지와 거주 분파 배치는 슬롯 1~21만 포함한다. 상층 22~26은 상주 거점 없음. 미확정 분파는 종족명·미정 상태로 표시한다.",
  "upperEcologyStatus": "상층 슬롯 22~24는 새 세계 정체성에 맞춘 종·먹이 관계 재검토가 남아 있다. 기존 생물 데이터는 삭제하지 않고 도감에서 재검토 상태로 표시한다."
 },
