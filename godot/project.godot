; FONS — Godot 4.x rebuild (docs/data/sim only, assets remade)
; Open with Godot 4.7+.

config_version=5

[application]

config/name="FONS (Godot)"
config/description="FONS Godot rebuild. Rules/data from soul-commander, assets remade."
run/main_scene="res://game/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[autoload]

GameState="*res://autoload/game_state.gd"
DataLoader="*res://autoload/data_loader.gd"
SaveManager="*res://autoload/save_manager.gd"

[fons]

view_mode="2d"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=true
